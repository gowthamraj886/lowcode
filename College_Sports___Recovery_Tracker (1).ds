		workflow
		{
		form
		{
			Injury_Reported_Alert as "Injury_Reported_Alert"
			{
				type =  form
				form = Injury_Report

				record event = on add

				on success
				{
					actions 
					{
						sendmail
						(
							from : "gowthamraj.m.2024.cse@rajalakshmi.edu.in"
							to : "kaileshm65552@gmail.com"
							subject : "New Sports Injury Reported"
							message : "<p><span>A new sports injury has been reported.</span><br></p><p><span>Please log in to the College Sports &amp; Recovery Tracker to review the injury details and update the assessment.</span><br></p><p><span>This is an automated notification.</span><br></p><div><br></div>"
						)
					}
				}

			}
			Recovery_Progress_Update as "Recovery_Progress_Update"
			{
				type =  form
				form = Recovery_Progress

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											if(Pain_Level >= 8)
										{
											sendmail
											[
												from :"gowthamraj.m.2024.cse@rajalakshmi.edu.in"
												to :"kaileshm65552@gmail.com"
												subject :"High Pain Level Alert"
												message :"<div><span>A recovery progress entry has recorded a pain level of 8 or above. Please review the player's condition.</span><br></div>"
											]
										}
						)
					}
				}

			}
			Recovery_Overdue_Alert1 as "Recovery_Overdue_Alert"
			{
				type =  form
				form = Recovery_Plan

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											if(Target_End_Date < zoho.currentdate && Plan_Status != "Completed")
										{
											sendmail
											[
												from :"gowthamraj.m.2024.cse@rajalakshmi.edu.in"
												to :"kaileshm65552@gmail.com"
												subject :"Recovery Overdue Alert"
												message :"A recovery plan has passed its target end date and is not yet completed. Please review the player's recovery status."
											]
										}
						)
					}
				}

			}
		}






	}
	share_settings
	{
			"Read"
			{
				name = "Read"
				type = Users_Permissions
				permissions = {Chat:true, Predefined:true, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "This profile will have read permission for all components\n"
			}
			"Write"
			{
				name = "Write"
				type = Users_Permissions
				permissions = {Chat:true, Predefined:true, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "This profile will have write permission for all components\n"
			}
			"Developer"
			{
				name = "Developer"
				type = Developer
				permissions = {Chat:false, Predefined:true, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "Developer Profile\n"
			}
			"Administrator"
			{
				name = "Administrator"
				type = Users_Permissions
				permissions = {Chat:true, Predefined:true, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "This profile will have all the permissions.\n"
			}
			"Customer"
			{
				name = "Customer"
				type = Customer_Portal
				permissions = {Chat:true, Predefined:true, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "This is the default profile having only add and view permission.\n"
			}
			roles
			{
				"CEO"
				{
					description = "User belonging to this role can access data of all other users."
				}
			}
	}

	customize
	{
		icon
		{
			text = "CSR"
			background color = "theme"
			foreground color = "#ffffff"
		}
	}

	web
	{
		forms
		{
			form Fitness_Clearance
			{
				label placement = left
			}
			form Injury_Report
			{
				label placement = left
			}
			form Player_Registration
			{
				label placement = left
			}
			form Recovery_Plan
			{
				label placement = left
			}
			form Recovery_Progress
			{
				label placement = left
			}
		}
		reports
		{
			report Player_Registration_Report
			{
				quickview
				(
					layout
					(
						datablock1
						(
							fields
							(
								Player_ID as "Player ID"
								Player_Name as "Player Name"
								Register_Number as "Register Number"
								Department
								Year_field as "Year"
								Sport
								Team_Name as "Team Name"
							)
						)
					)
						menu
						(
							header
							(
								Edit 
								Duplicate 
								Delete 
							)
						record
						(
							Edit   	   
							Duplicate   	   
							Delete   	   
    					)
						)
    				action
    				(
						on click
						(
							View Record   	   
    					)
						on right click
						(
							Edit   	   
							Delete   	   
							Duplicate   	   
							View Record   	   
    					)
